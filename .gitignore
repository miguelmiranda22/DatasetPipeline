# ---------------------------------------------------------------------------
# Data. Nothing under data/ is versioned - the ChEMBL dump alone is tens of GB
# and the AlphaFold PDB set is far larger. Only code and documentation go in.
# ---------------------------------------------------------------------------
data/
!data/.gitkeep

# Raw and intermediate artefacts, wherever they land
*.pkl
*.pickle
*.db
*.sqlite
*.sqlite3
*.pdb
*.cif
*.mmcif
*.parquet
*.feather
*.npy
*.npz
*.h5
*.hdf5
*.gz
*.tar
*.zip
*.7z

# Result tables are large and belong with the experiments, not here
*.csv
*.tsv
!**/example_*.csv
!**/schema_*.csv

# Cluster job output
*.out
*.err
slurm-*.out
*_job_*.txt

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Seed chunks are regenerated by extract_sql_seeds_and_years.py (step 2)
seeds/
